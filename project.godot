; Purrfect Territory 3D — Godot 4.7 project configuration

config_version=5

[application]

config/name="Purrfect Territory 3D"
config/version="1.0.0"
config/description="A portrait-first 3D cat territory logic puzzle: one cat per row, column and territory, and no two cats touch."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.07, 0.05, 0.10, 1)
boot_splash/show_image=false

[autoload]

Save="*res://Scripts/Core/SaveManager.gd"
Audio="*res://Scripts/Core/AudioManager.gd"
Arcade="*res://Scripts/Core/ArcadeBridge.gd"
Levels="*res://Scripts/Core/Levels.gd"
Router="*res://Scripts/Core/Router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=430
window/size/window_height_override=764
window/stretch/mode="canvas_items"
; "expand" lets the 3D board use every pixel of a tall phone instead of sitting
; inside black 9:16 bars. The HUD is anchored, so extra height lands around the
; board; landscape windows are covered by the rotate gate.
window/stretch/aspect="expand"
window/size/handheld/orientation=1
window/size/resizable=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.05, 0.10, 1)

[audio]

driver/mix_rate=44100

[input_devices]

# A touch that also arrives as an emulated mouse click toggles the same square
# twice. Board3D handles InputEventScreenTouch and InputEventMouseButton itself,
# so both emulation directions stay off.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false
